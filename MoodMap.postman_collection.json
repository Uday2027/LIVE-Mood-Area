{
  "info": {
    "name": "MoodMap API",
    "_postman_id": "moodmap-api-collection",
    "description": "Complete API collection for MoodMap — all endpoints with example request bodies.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url",   "value": "http://localhost:5000/api", "type": "string" },
    { "key": "token",      "value": "",                           "type": "string" },
    { "key": "session_id", "value": "b3f2a1e4-9c8d-4765-8b3a-2c1d0e5f6a7b", "type": "string" },
    { "key": "pin_id",     "value": "",                           "type": "string" },
    { "key": "circle_id",  "value": "",                           "type": "string" },
    { "key": "match_id",   "value": "",                           "type": "string" },
    { "key": "story_id",   "value": "",                           "type": "string" },
    { "key": "ping_id",    "value": "",                           "type": "string" },
    { "key": "user_id",    "value": "",                           "type": "string" }

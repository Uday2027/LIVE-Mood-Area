        {
          "name": "Delete Pin",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "x-session-id", "value": "{{session_id}}" }],
            "url": { "raw": "{{base_url}}/pins/{{pin_id}}", "host": ["{{base_url}}"], "path": ["pins", "{{pin_id}}"] }

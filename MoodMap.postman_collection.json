  "item": [
    {
      "name": "🔒 Auth",
      "item": [
        {
          "name": "Register",
          "event": [{ "listen": "test", "script": { "exec": [
            "const json = pm.response.json();",
            "if (json.data && json.data.token) pm.collectionVariables.set('token', json.data.token);",
            "if (json.data && json.data.user) pm.collectionVariables.set('user_id', json.data.user.id);"
          ], "type": "text/javascript" }}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"testuser\",\n  \"email\": \"test@moodmap.app\",\n  \"password\": \"Password1\"\n}" },
            "url": { "raw": "{{base_url}}/auth/register", "host": ["{{base_url}}"], "path": ["auth", "register"] }
          }
        },
        {
          "name": "Login",
          "event": [{ "listen": "test", "script": { "exec": [
            "const json = pm.response.json();",
            "if (json.data && json.data.token) pm.collectionVariables.set('token', json.data.token);",
            "if (json.data && json.data.user) pm.collectionVariables.set('user_id', json.data.user.id);"
          ], "type": "text/javascript" }}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"test@moodmap.app\",\n  \"password\": \"Password1\"\n}" },
            "url": { "raw": "{{base_url}}/auth/login", "host": ["{{base_url}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "Get Me",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{base_url}}/auth/me", "host": ["{{base_url}}"], "path": ["auth", "me"] }
          }
        }
      ]
    },
    {
      "name": "📍 Pins",
      "item": [
        {
          "name": "Get Active Pins",
          "request": {
            "method": "GET",
            "header": [{ "key": "x-session-id", "value": "{{session_id}}" }],
            "url": { "raw": "{{base_url}}/pins/active", "host": ["{{base_url}}"], "path": ["pins", "active"] }
          }
        },
        {
          "name": "Drop Pin",
          "event": [{ "listen": "test", "script": { "exec": [
            "const json = pm.response.json();",
            "if (json.data && json.data.id) pm.collectionVariables.set('pin_id', json.data.id);"
          ], "type": "text/javascript" }}],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-session-id", "value": "{{session_id}}" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"mood\": \"HYPE\",\n  \"message\": \"This place is buzzing!\",\n  \"latitude\": 24.8607,\n  \"longitude\": 67.0011\n}" },
            "url": { "raw": "{{base_url}}/pins", "host": ["{{base_url}}"], "path": ["pins"] }
          }
        },
        {
          "name": "Vote on Pin — CONFIRM",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-session-id", "value": "c4e3b2f1-7d6a-4891-9cde-f012345678ab" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"vote\": \"CONFIRM\"\n}" },
            "url": { "raw": "{{base_url}}/pins/{{pin_id}}/vote", "host": ["{{base_url}}"], "path": ["pins", "{{pin_id}}", "vote"] }
          }
        },
        {
          "name": "Vote on Pin — DISPUTE",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-session-id", "value": "d5f4c3e2-8e7b-4902-adf1-012345678bcd" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"vote\": \"DISPUTE\"\n}" },
            "url": { "raw": "{{base_url}}/pins/{{pin_id}}/vote", "host": ["{{base_url}}"], "path": ["pins", "{{pin_id}}", "vote"] }
          }
        },
        {
          "name": "Get Pin Votes",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/pins/{{pin_id}}/votes", "host": ["{{base_url}}"], "path": ["pins", "{{pin_id}}", "votes"] }
          }
